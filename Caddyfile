# Public TLS edge for the production overlay (docker-compose.prod.yml).
#
# Caddy obtains and renews Let's Encrypt certificates automatically from the
# hostname below — there is no certbot step and no renewal cron to forget.
# HTTP is redirected to HTTPS by default.
{
	email {$ACME_EMAIL}
	# Uncomment to test against the staging CA while iterating on DNS or
	# firewall rules. The production CA rate-limits failed attempts hard
	# (5 duplicate certs/week), and a wrong DNS record burns them fast.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$PUBLIC_HOSTNAME} {
	# Content types are listed explicitly rather than using the default `text/*`
	# so that text/event-stream is NOT compressed: buffering a compressed stream
	# stalls the SSE live views (/api/traffic/stream, /api/alerts/stream).
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	# SECURITY: nginx guards /metrics with an RFC1918 allow-list, which trusts
	# any client on the docker bridge network — including this proxy. Every
	# request arriving through Caddy would therefore pass that check, so the
	# endpoint has to be closed here instead. Prometheus is unaffected: it
	# scrapes web:8000 directly over the compose network, never through Caddy.
	handle /metrics* {
		abort
	}

	handle {
		# To nginx, not straight to web:8000 — nginx applies the limit_req zone
		# and redacts `auth=` query parameters out of its access log.
		reverse_proxy nginx:80 {
			header_up X-Forwarded-Proto https
		}
	}

	# The app already emits HSTS, CSP, X-Frame-Options and friends
	# (app/main.py) and nginx re-adds several; nothing further is set here to
	# avoid duplicate headers.

	log {
		output stdout
		# The access log is shipped to Loki by promtail. Request URIs can carry
		# SSE credentials in the query string, so log the path only.
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
