# ============================================================
#  API Security Monitor — environment variable template
#
#  SETUP:
#    cp .env.example .env
#    # Edit .env — fill in every value marked REQUIRED.
#    # Never commit .env — it is already in .gitignore.
#
#  Generate strong random values with:
#    openssl rand -hex 32     → use for SECRET_KEY and MONITOR_API_KEY
#    openssl rand -base64 24  → use for passwords
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
# REQUIRED — Docker Compose aborts with a clear error if either is missing.

MYSQL_ROOT_PASSWORD=<strong-random-root-password>

# Must match the password embedded in DATABASE_URL below.
MYSQL_PASSWORD=<strong-random-app-db-password>

# ── FastAPI application ──────────────────────────────────────
# REQUIRED — the Python app refuses to start in production without these.

# Full connection string — replace <strong-random-app-db-password> with
# the same value as MYSQL_PASSWORD above.
DATABASE_URL=mysql+pymysql://apimonitor:<strong-random-app-db-password>@127.0.0.1:3306/apimonitor

# JWT signing key — minimum 32 characters, must not start with "change-me".
SECRET_KEY=<hex-64-chars-from-openssl-rand-hex-32>

# API key for non-JWT automation clients — minimum 32 characters.
MONITOR_API_KEY=<hex-64-chars-from-openssl-rand-hex-32>

# Bootstrap admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-random-admin-password>

# ── Grafana ──────────────────────────────────────────────────
# REQUIRED — Docker Compose aborts if missing.

GRAFANA_ADMIN_PASSWORD=<strong-random-grafana-password>

# ── Optional / defaulted ────────────────────────────────────
# Leave these as-is for local development; adjust for production.

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Extra CORS origins for the browser UI (comma-separated).
# Leave empty when the UI and API share the same origin.
CORS_ORIGINS=

# Retrain the anomaly detection model every N minutes (minimum 5).
ML_RETRAIN_MINUTES=15

# Hours before a documented endpoint is flagged as idle.
IDLE_THRESHOLD_HOURS=24

# Set to "production" to enforce strict secret validation at startup.
# The override file (docker-compose.override.yml) sets this to "development"
# automatically when you run plain `docker compose up`.
# APP_ENV=production
