# ============================================================
#  API Security Monitor — environment variable template
#
#  SETUP:
#    cp .env.example .env
#    # Edit .env — fill in every value marked REQUIRED.
#    # Never commit .env — it is already in .gitignore.
#
#  Generate strong random values with:
#    openssl rand -hex 32     → use for SECRET_KEY and MONITOR_API_KEY
#    openssl rand -base64 24  → use for passwords
# ============================================================

# ── MySQL ────────────────────────────────────────────────────
# REQUIRED — Docker Compose aborts with a clear error if either is missing.

MYSQL_ROOT_PASSWORD=<strong-random-root-password>

# Must match the password embedded in DATABASE_URL below.
MYSQL_PASSWORD=<strong-random-app-db-password>

# ── FastAPI application ──────────────────────────────────────
# REQUIRED — the Python app refuses to start in production without these.

# Full connection string — replace <strong-random-app-db-password> with
# the same value as MYSQL_PASSWORD above.
DATABASE_URL=mysql+pymysql://apimonitor:<strong-random-app-db-password>@127.0.0.1:3306/apimonitor

# JWT signing key — minimum 32 characters, must not start with "change-me".
SECRET_KEY=<hex-64-chars-from-openssl-rand-hex-32>

# API key for non-JWT automation clients — minimum 32 characters.
MONITOR_API_KEY=<hex-64-chars-from-openssl-rand-hex-32>

# Optional. Encrypts the third-party provider keys saved under "Connected
# APIs" (Claude / Gemini / OpenAI). Leave unset to derive one from SECRET_KEY
# — set it explicitly if you ever intend to rotate SECRET_KEY, because doing
# so otherwise makes every saved provider key undecryptable.
# ENCRYPTION_KEY=<hex-64-chars-from-openssl-rand-hex-32>

# Bootstrap admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-random-admin-password>

# ── Grafana ──────────────────────────────────────────────────
# REQUIRED — Docker Compose aborts if missing.

GRAFANA_ADMIN_PASSWORD=<strong-random-grafana-password>

# ── Optional / defaulted ────────────────────────────────────
# Leave these as-is for local development; adjust for production.

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Extra CORS origins for the browser UI (comma-separated).
# Leave empty when the UI and API share the same origin.
CORS_ORIGINS=

# --- Public deployment (docker-compose.prod.yml only) ---------------------
# Required only when deploying with the production overlay; ignored otherwise.
# See docs/deployment-oracle-free.md.
#
# The public hostname Caddy requests a Let's Encrypt certificate for. DNS must
# already resolve it to this host's public IP before the first startup, or
# certificate issuance fails. The overlay derives CORS_ORIGINS and
# PUBLIC_BASE_URL from it, so leave CORS_ORIGINS above empty.
# PUBLIC_HOSTNAME=yourname.duckdns.org
#
# Where Let's Encrypt sends certificate-expiry warnings.
# ACME_EMAIL=you@example.com

# Retrain the anomaly detection model every N minutes (minimum 5).
ML_RETRAIN_MINUTES=15

# Hours before a documented endpoint is flagged as idle.
IDLE_THRESHOLD_HOURS=24

# Set to "production" to enforce strict secret validation at startup.
# The override file (docker-compose.override.yml) sets this to "development"
# automatically when you run plain `docker compose up`.
# APP_ENV=production

# Legacy `?auth=<token>` credential fallback. NOT needed for the live views —
# the Live Traffic page and alert toasts now authenticate with short-lived
# stream tickets (see app/security.py::create_stream_ticket), which is why
# this is off.
#
# Leave it off. The bundled nginx config redacts `auth` from its own access
# log, but that covers exactly one hop: the application's uvicorn access log
# (shipped to Loki by the promtail service in docker-compose.yml) and any
# ingress controller or cloud load balancer in front of it all record the
# raw value.
# ALLOW_QUERY_AUTH=true

# ── Email (required for self-service password reset) ────────
# With SMTP_HOST unset, nothing is sent: a user who forgets their password
# has to be reset by an administrator. Set these to turn on self-service
# recovery. The reset token travels only in the email body — it is never
# logged and never returned by the API.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apimonitor@example.com
# SMTP_PASSWORD=<smtp-password>
# SMTP_FROM=API Security Monitor <no-reply@example.com>
# SMTP_USE_STARTTLS=true      # port 587; set SMTP_USE_SSL=true for port 465 instead
# Origin used to build the reset link. Without it the email can only quote
# the bare token, which the user then has to paste in by hand.
# PUBLIC_BASE_URL=https://monitor.example.com

# ── Optional infrastructure (opt-in) ────────────────────────
# `docker compose up` wires these automatically (see docker-compose.yml's
# `web`/`worker` services) — you don't need to set them here for that path.
# Only relevant if you're running the API locally via `uvicorn` (make dev)
# and want to exercise the ingest queue / distributed rate limiting /
# leader election, or tracing, against the Docker-Compose-provided
# redis/jaeger containers (`docker compose up -d redis jaeger`).
# REDIS_URL=redis://127.0.0.1:6379/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=apimonitor-web
